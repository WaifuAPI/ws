# MongoDB connection URI  
# Replace with your actual uri  
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority  

# MongoDB database name (change as needed)  
MONGODB_NAME=mydatabase  

# Collections used in the database  
# Replace these with your actual collection names.  
# For reference:  
# - The first collection should be for global notifications.  
# - The second collection should be for user-specific notifications.  
COLLECTIONS=globalnotification,usernotification

# Port for the server to run on
PORT=

# Discord webhook URL for sending notifications
# Replace with your actual webhook URL
DISCORD_WEBHOOK=https://discord.com/api/webhooks/123456789012345678/abcdefghijklmnopqrstuvwxyz1234567890
